def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)

def run_step(name, cmd, timeout=600):
    log(f"▶ {name} ...")
    t0 = time.time()
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
    elapsed = int(time.time() - t0)
    if r.returncode == 0:
        log(f"  ✅ {name} 完成 ({elapsed}s)")
    else:
        log(f"  ❌ {name} 失败: {r.stderr.strip()[-200:]}")
    return r.returncode == 0

# ═══════════════════════════════════════════════════════════════
# STEP 1: 全A股量价金叉扫描（股价>MA25 + 量MA5上穿MA60）
# ═══════════════════════════════════════════════════════════════
def scan_volume_gc() -> set:
    """全市场扫描量价金叉，返回符合条件股票代码集合"""
    log("▶ 全A股量价金叉扫描...")
    from data_fetcher import get_kline_sina, get_stock_list

    stocks = get_stock_list()
    symbols = [s for s in stocks["symbol"].tolist() if not s.startswith("bj")]
    log(f"  全A股: {len(symbols)} 只")

    gc_set = set()

    def check(sym):
        try:
            kl = get_kline_sina(sym, start_date="20260301")
            if kl is None or kl.empty:
                return None
            kl = kl.sort_values("date").reset_index(drop=True)
            if len(kl) < 61:
                return None
            c = kl["close"].values
            v = (kl["volume"] if "volume" in kl.columns else kl["amount"]).values
            ma25 = pd.Series(c).rolling(25).mean().values
            vm5 = pd.Series(v).rolling(5).mean().values
            vm60 = pd.Series(v).rolling(60).mean().values
            l = len(kl) - 1
            if bool(c[l] > ma25[l] and vm5[l] > vm60[l] and vm5[l-1] <= vm60[l-1]):
                return sym
            return None
        except:
            return None

    with ThreadPoolExecutor(max_workers=30) as ex:
        futs = {ex.submit(check, s): s for s in symbols}
        for i, fut in enumerate(as_completed(futs)):
            r = fut.result()
            if r:
                gc_set.add(r)
            if (i + 1) % 500 == 0:
                log(f"  扫描: {i+1}/{len(symbols)}, 已发现: {len(gc_set)}")

    # 保存到文件
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    with open(f"{OUTPUT_DIR}/volume_gc_pool.json", "w") as f:
        json.dump(list(gc_set), f)
    log(f"  ✅ 量价金叉: {len(gc_set)} 只")
    return gc_set

